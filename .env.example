# Copia este fichero a .env y rellena los valores reales (nunca subas .env al repo)

# Base de datos — MySQL (contenedor Docker)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# Base de datos — credenciales que usa Spring Boot para conectarse
# En local pueden ser las mismas que MYSQL_USER/PASSWORD
DB_USER=
DB_PASSWORD=

# Hibernate DDL: "validate" en producción/staging, "update" solo en desarrollo inicial
DDL_AUTO=validate

# Rutas de almacenamiento local (ignoradas en Docker, que usa volúmenes fijos)
UPLOAD_DIR=./uploads/videos
THUMBNAILS_DIR=./uploads/thumbnails

# JWT (Base64, mínimo 256 bits — genera uno con: openssl rand -base64 32)
JWT_SECRET=

# Origen permitido por CORS (URL pública del frontend, sin barra final)
# Ejemplo local:     http://localhost:4200
# Ejemplo VPS:       https://lockstrm.tudominio.com
CORS_ORIGIN=
