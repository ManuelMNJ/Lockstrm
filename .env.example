# Copia este fichero a .env y rellena los valores reales (nunca subas .env al repo)

# Base de datos — MySQL (contenedor Docker)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# Base de datos — credenciales que usa Spring Boot para conectarse
# En local pueden ser las mismas que MYSQL_USER/PASSWORD
DB_USER=
DB_PASSWORD=

# Hibernate DDL: "validate" en producción/staging, "update" solo en desarrollo inicial
DDL_AUTO=validate

# Rutas de almacenamiento local (ignoradas en Docker, que usa volúmenes fijos)
UPLOAD_DIR=./uploads/videos
THUMBNAILS_DIR=./uploads/thumbnails
AVATARS_DIR=./uploads/avatars
GRUPOS_IMG_DIR=./uploads/grupos

# JWT (mínimo 256 bits de entropía — genera uno con: openssl rand -base64 32)
JWT_SECRET=

# Origen permitido por CORS (URL pública del frontend, sin barra final)
# Ejemplo local:     http://localhost:4200
# Ejemplo VPS:       https://lockstrm.tudominio.com
CORS_ORIGIN=

# URL del backend para el build del frontend en Docker
# En local con Docker: http://localhost:8080
# En VPS: https://api.tudominio.com
API_URL=http://localhost:8080

# Correo (para recuperación de contraseña — dejar vacío desactiva esta función)
# Guía para Gmail: Cuenta → Seguridad → Contraseñas de aplicaciones
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lockstrm.app
APP_URL=http://localhost:4200
RESET_TOKEN_EXPIRY_MINUTES=30
