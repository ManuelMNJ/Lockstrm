# Copia este archivo a .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio

# Base de datos
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_USER=lockstrm_user
MYSQL_PASSWORD=cambia_esto

# Cloudinary (obtenlos en https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# CORS: origen permitido (por defecto localhost:4200 para despliegue local)
# Si despliegas en un servidor, pon la URL publica: https://tu-dominio.com
CORS_ORIGIN=http://localhost:4200
